{
  "name": "@siwah/tui",
  "private": true,
  "type": "module",
  "version": "1.0.2",
  "scripts": {
    "start": "bun --conditions=browser src/index.tsx",
    "build": "bun build.ts",
    "bench": "bun --conditions=browser test/bench/stream.tsx",
    "generate:types": "openapi-typescript openapi.json -o src/api/schema.d.ts && biome format --write src/api/schema.d.ts",
    "check:types": "bun run generate:types && git diff --exit-code -- openapi.json src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --conditions=browser",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "@biomejs/biome": "2.6.6"
  },
  "dependencies": {
    "@opentui/core": "0.8.3",
    "@opentui/solid": "0.8.3",
    "solid-js": "1.9.18",
    "web-tree-sitter": "0.25.10"
  }
}
